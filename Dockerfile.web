FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements-api.txt requirements-train.txt requirements-web.txt ./
RUN python -m pip install --no-cache-dir     -r requirements-api.txt     -r requirements-train.txt     -r requirements-web.txt

COPY src ./src
COPY training ./training
COPY app.py ./app.py
COPY sample.csv ./sample.csv
COPY "train data.zip" "./train data.zip"

RUN mkdir -p /app/artifacts && chown -R app:app /app

USER app

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --retries=5   CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health').read()"

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
